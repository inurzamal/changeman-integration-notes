package com.snowman.changeman.controller;

import com.snowman.changeman.dto.CreatePackageRequest;
import com.snowman.changeman.service.ChangeManService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/changeman")
@RequiredArgsConstructor
public class ChangeManController {

    private final ChangeManService changeManService;

    @PostMapping("/package/{lpar}")
    public String createPackage(@PathVariable String lpar,
                                @RequestBody CreatePackageRequest request) {

        return changeManService.createPackage(lpar, request);
    }
}
