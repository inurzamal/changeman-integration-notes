package com.snowman.changeman.service;

import com.snowman.changeman.client.ChangeManApiClient;
import com.snowman.changeman.dto.CreatePackageRequest;
import com.snowman.changeman.entity.LparEntity;
import com.snowman.changeman.repository.LparRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpMethod;
import org.springframework.stereotype.Service;

@Service
@RequiredArgsConstructor
@Slf4j
public class ChangeManService {

    private final LparRepository lparRepository;
    private final ChangeManApiClient apiClient;

    public String createPackage(String lparName, CreatePackageRequest request) {

        LparEntity lpar = lparRepository.findByName(lparName)
                .orElseThrow(() -> new RuntimeException("LPAR not found"));

        String url = lpar.getUrl() + "/zmfrest/package";

        return apiClient.callApi(
                url,
                lpar.getFidName(),
                lpar.getFidPassword(),
                HttpMethod.POST,
                request
        );
    }
}
