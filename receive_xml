package com.citi.sea.batcheng.changeman.controllers;

import com.citi.sea.batcheng.changeman.services.ChangemanFilewatcherService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/changeman/filewatcher")
@RequiredArgsConstructor
public class ChangemanFilewatcherController {

    private final ChangemanFilewatcherService service;

    @PostMapping(consumes = {"application/xml", "text/plain"})
    public ResponseEntity<String> receiveXml(@RequestBody String xml) {

        service.saveRawXml(xml, "REST");

        return ResponseEntity.accepted().body("XML received");
    }
}
