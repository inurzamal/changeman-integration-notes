package com.citi.sea.batcheng.changeman.documents;

import lombok.*;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.index.Indexed;
import org.springframework.data.mongodb.core.mapping.Document;

import java.time.Instant;

@Getter
@Setter
@Builder
@NoArgsConstructor
@AllArgsConstructor
@Document(collection = "changeman_raw_xml")
public class ChangemanRawXml {

    @Id
    private String id;

    /**
     * Full raw XML payload received from Changeman.
     */
    private String payload;

    /**
     * Timestamp when Snowman received the message (UTC).
     */
    @Indexed // useful for time-based queries & cleanup later
    private Instant receivedAt;

    /**
     * Processing lifecycle status.
     * For now always set to RECEIVED.
     */
    private ProcessingStatus status;

    /**
     * Source of ingestion (REST / FILEWATCHER / etc).
     */
    private String source;
}

