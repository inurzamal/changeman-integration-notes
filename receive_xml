package com.citi.sea.batcheng.changeman.repositories;

import com.citi.sea.batcheng.changeman.documents.ChangemanRawXml;
import org.springframework.data.mongodb.repository.MongoRepository;

public interface ChangemanRawXmlRepository
        extends MongoRepository<ChangemanRawXml, String> {
}
