package com.citi.sea.batcheng.changeman.services;

import com.citi.sea.batcheng.changeman.documents.ChangemanRawXml;
import com.citi.sea.batcheng.changeman.enums.ProcessingStatus;
import com.citi.sea.batcheng.changeman.repositories.ChangemanRawXmlRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.time.Instant;

@Service
@RequiredArgsConstructor
public class ChangemanFilewatcherService {

    private final ChangemanRawXmlRepository repository;

    public void saveRawXml(String xml, String source) {

        ChangemanRawXml doc = ChangemanRawXml.builder()
                .payload(xml)
                .receivedAt(Instant.now())
                .status(ProcessingStatus.RECEIVED)
                .source(source)
                .build();

        repository.save(doc);
    }
}

